TEXT 72 -104 Left 2 ;ELECTENG 209 - ANALOGUE ENERGY MONITOR
TEXT 72 -72 Left 2 ;Edit VRMS, FREQ and RLOAD below for testing
TEXT 72 -40 Left 2 !.param VRMS=14 FREQ=500 RLOAD=28.5
TEXT 72 -8 Left 2 ;.tran 0 0.5 0.30 50u
TEXT 72 24 Left 2 !.options plotwinsize=0
TEXT -728 200 Left 2 ;BLOCK A - AC SOURCE, LOAD, CURRENT SHUNT AND VOLTAGE DIVIDER
TEXT -464 656 Left 2 ;RSHUNT = 0.5 ohm; voltage divider = 100k/4.7k. SHUNT_TOP is Vis.
TEXT 368 128 Left 2 ;BLOCK B - CURRENT DIFFERENTIAL AMPLIFIER / LEVEL SHIFT
TEXT 336 552 Left 2 ;I_OUT = VREF + (22k/10k)*Vshunt ~ VREF + 2.2*Vshunt
TEXT 344 688 Left 2 ;BLOCK C - VOLTAGE DIFFERENTIAL AMPLIFIER / LEVEL SHIFT
TEXT 496 1224 Left 2 ;5.6k compensates the 100k||4.7k divider Thevenin resistance.
TEXT 1208 120 Left 2 ;BLOCK D - CURRENT 2nd ORDER BUTTERWORTH LPF (~1.65 kHz)
TEXT 1224 552 Left 2 ;CIFB is the Sallen-Key feedback capacitor; CISH is the shunt capacitor.
TEXT 1312 688 Left 2 ;BLOCK E - VOLTAGE 2nd ORDER BUTTERWORTH LPF (~1.65 kHz)
TEXT 1344 1088 Left 2 ;Voltage and current filters are identical so relative phase error largely cancels.
TEXT -656 840 Left 2 ;BLOCK F - HALF-WAVE RECTIFIER + 5 V REGULATOR
TEXT -976 1304 Left 2 ;Connect Vac ONLY FOR TRANSIENT ANALYSIS
TEXT 224 1376 Left 2 ;BLOCK G - CLEAN 2.1 V OFFSET REFERENCE
TEXT 240 1824 Left 2 ;VREF ~ 5*3.3/(4.7+3.3) = 2.0625 V. Buffer prevents loading by both differential amplifiers.
TEXT 1520 1472 Left 2 ;BLOCK H - VOLTAGE ZERO-CROSS DETECTOR
TEXT 1520 1696 Left 2 ;Comparator switches when V_OUT = VREF, which corresponds to VAC = 0.
TEXT 1520 1728 Left 2 ;Using unfiltered V_OUT here so the anti-alias filter's ~25 degree phase delay is not added.
TEXT -480 -104 Left 2 ;Verification parameter sets:
TEXT -480 -56 Left 2 ;7.5 VA @12.6 V: RLOAD~16.53 ohm
TEXT -480 -24 Left 2 ;7.5 VA @15.4 V: RLOAD~28.52 ohm
TEXT -480 8 Left 2 ;2.5 VA @15.4 V: RLOAD~93.53 ohm
TEXT -480 40 Left 2 ;Frequency limits: 490 Hz and 510 Hz
TEXT 72 56 Left 2 !.lib LM324.lib
TEXT 72 88 Left 2 !.ac dec 10 1 100kHz
